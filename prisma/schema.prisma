// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SCHOOL_OWNER
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(SCHOOL_OWNER)
  school    School?  @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  schoolId  Int?
}

model School {
  id         Int      @id @default(autoincrement())
  name       String
  address    String?
  proprietor String?
  createdAt  DateTime @default(now())

  members Member[]
  events  Event[]
  users   User[]
}

model Member {
  id       Int     @id @default(autoincrement())
  name     String
  role     String
  email    String  @unique
  schoolId Int?
  school   School? @relation(fields: [schoolId], references: [id])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  date        DateTime

  // Relation to School
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
}
